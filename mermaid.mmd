sequenceDiagram
    actor U as Gość
    participant H as :HotelSystem
    participant G as g : Guest

    activate U
    U->>+H: makeReservation(guestId, from, to, roomNumber)
    H->>H: checkAvailability(from, to)
    H--)H: currentlyAvailableRooms : vector#lt;int#gt;

    loop dla każdego g w guestList
        H->>+G: getId()
        G--)-H: id : int
    end

    alt gość istnieje & pokój dostępny & from < to
        create participant R as :Reservation
        H--)R: «create» Reservation(nextReservationId, guestId, roomNumber, from, to)
        H--)U: reservationId : int
    else dane niepoprawne
        H--)U: -1
    end
    deactivate H
    deactivate U
